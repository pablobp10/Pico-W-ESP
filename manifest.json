{
  "id": "/Pico-W-ESP/Pico_OS",
  "name": "Pico OS",
  "short_name": "Pico OS",
  "description": "IA de la frambuesa",
  "start_url": "/Pico-W-ESP/",
  "scope": "/Pico-W-ESP/",
  "display": "standalone",
  "display_override": ["tabbed", "window-controls-overlay", "minimal-ui"],
  "background_color": "#121212",
  "theme_color": "#0a84ff",
  "orientation": "portrait-primary",
  "lang": "es-ES",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "smart-home"],
  "prefer_related_applications": false,
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    { "src": "logo-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "logo-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "logo-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "captura-mobile.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow" },
    { "src": "captura-desktop.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide" }
  ],
  "shortcuts": [
    {
      "name": "Lista de Compra",
      "short_name": "Comprar",
      "description": "Abre directamente la lista",
      "url": "/Pico-W-ESP/?action=lista",
      "icons": [{ "src": "logo-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Modo Fiesta",
      "short_name": "Fiesta",
      "description": "Activa el modo fiesta",
      "url": "/Pico-W-ESP/?action=fiesta",
      "icons": [{ "src": "logo-192.png", "sizes": "192x192" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/Pico-W-ESP/",
      "accept": { "application/json": [".json"], "text/plain": [".txt"] }
    }
  ],
  "protocol_handlers": [
    { "protocol": "web+pico", "url": "/Pico-W-ESP/?cmd=%s" }
  ],
  "share_target": {
    "action": "/Pico-W-ESP/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "related_applications": [
    { "platform": "play", "url": "https://play.google.com/store/apps/details?id=com.pablo.picoos", "id": "com.pablo.picoos" }
  ],
  "widgets": [
    {
      "name": "Pico OS Control",
      "description": "Control rápido de módulos",
      "tag": "pico-widget",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json"
    }
  ],
  "edge_side_panel": { "preferred_width": 400 },
  "note_taking": { "new_note_url": "/Pico-W-ESP/?action=new_note" }
}
